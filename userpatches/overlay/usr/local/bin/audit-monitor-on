#!/bin/sh
# Uso: audit-monitor-on [canal]   (por defecto 11)
# Ojo: no bajar/subir la interfaz después de cambiar el tipo; el driver
# rtl8814au pierde los flags de inyección si se hace.
IF=$(/usr/local/bin/audit-iface) || { echo "RTL8814AU no encontrado"; exit 1; }
CH=${1:-11}
ip link set "$IF" up || exit 1
iw dev "$IF" set type monitor || exit 1
iw dev "$IF" set monitor otherbss fcsfail || exit 1
iwconfig "$IF" channel "$CH" || exit 1
echo "Monitor ON: $IF  canal $CH"
iw dev "$IF" info | grep -iE "type|channel" | head -3
