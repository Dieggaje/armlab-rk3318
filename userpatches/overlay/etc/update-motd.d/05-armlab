#!/bin/bash
# ARMLAB WIFI - logo de arranque para RK3318
# Instalado como /etc/update-motd.d/05-armlab

printf '\033[1;33m'
/usr/bin/figlet -f small 'RK3318' 2>/dev/null || printf 'RK3318\n'
/usr/bin/figlet -f small 'ArmLab WiFi' 2>/dev/null || printf 'ArmLab WiFi\n'
printf '\033[0m'
printf '  Auditoria WiFi  |  %s  |  13 dBm\n' "$(hostname)"
printf '  sudo lab  ->  menu de herramientas\n'
printf '\033[1;33m  by DieGGaje\033[0m\n'
printf '\n'
exit 0
